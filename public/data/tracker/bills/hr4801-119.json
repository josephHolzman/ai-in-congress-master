{"id":"hr4801-119","summary":{"version":"Reported to House","date":"2026-06-24","excerpt":["This bill allows regulated financial entities to test artificial intelligence (AI) projects under waived or modified regulations upon the approval of an application by the appropriate federal financial regulatory agency. These agencies must establish AI innovation labs to enable such projects."]},"milestones":[{"date":"2025-07-29","label":"Introduced in the House"},{"date":"2025-07-29","label":"Referred to committee"},{"date":"2026-06-24","label":"Reported by committee"}],"committees":[{"name":"Financial Services Committee","chamber":"House","latest":{"name":"Reported By","date":"2026-06-24"}}],"cosponsors":{"count":3,"D":2,"R":1,"I":0,"original":3,"latestDate":"2025-07-29"},"companions":[{"id":"s2528-119","label":"S. 2528","href":"#s2528-119"}],"cbo":[],"law":null,"text":{"version":"Reported in House","date":"2026-06-24","url":"https://www.congress.gov/119/bills/hr4801/BILLS-119hr4801rh.htm"},"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/4801","subjects":["Advanced technology and technological innovations","Advisory bodies","Banking and financial institutions regulation","Computers and information technology","Data collection, sharing, protection","Financial services and investments","Licensing and registrations","Performance measurement","Research and development"],"policyArea":"Finance and Financial Sector"}