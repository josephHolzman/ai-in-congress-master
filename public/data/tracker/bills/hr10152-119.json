{"id":"hr10152-119","summary":{"version":"Introduced in House","date":"2026-08-27","excerpt":["This bill requires the Department of Commerce to assess and publish information about risks related to use of certain foreign adversary artificial intelligence (AI) models. The bill also authorizes Commerce to take specified actions to support adoption of U.S. AI models."]},"milestones":[{"date":"2026-08-27","label":"Introduced in the House"},{"date":"2026-08-27","label":"Referred to committee"}],"committees":[{"name":"Energy and Commerce Committee","chamber":"House","latest":{"name":"Markup By","date":"2026-09-16"}}],"cosponsors":{"count":0,"D":0,"R":0,"I":0,"original":0},"companions":[],"cbo":[],"law":null,"text":{"version":"Introduced in House","date":"2026-08-27","url":"https://www.congress.gov/119/bills/hr10152/BILLS-119hr10152ih.htm"},"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/10152","subjects":["Advanced technology and technological innovations","Computers and information technology","Congressional oversight","Data collection, sharing, protection","Government information and archives","Intergovernmental relations","Public-private cooperation","Technology assessment"],"policyArea":"Science, Technology, Communications"}